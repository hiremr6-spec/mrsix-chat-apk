# === Application Identity ===
APP_NAME=MR.SIX
APP_TAGLINE="MR.SIX powered by Mister 6"

# === Mister 6 Configuration ===
MISTER_6_API_KEY=your_mister_6_api_key_here
MISTER_6_ACCESS_POLICY=unrestricted
MISTER_6_ALLOW_FILE_INSPECTION=true
MISTER_6_ALLOW_SYSTEM_CHECKS=true
MISTER_6_ALLOW_DATA_ACCESS=true

# === Backend Service ===
BACKEND_PORT=8000
FRONTEND_PORT=8080
BACKEND_WORKERS=4
BACKEND_TIMEOUT=30

# === Database ===
DATABASE_URL=postgresql://mrsix:mrsix_password@db:5432/mrsix_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# === Cache ===
REDIS_URL=redis://cache:6379/0
REDIS_CACHE_TTL=3600

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mrsix/app.log

# === Security ===
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
SECRET_KEY=your_secret_key_change_in_production
API_KEY_HEADER=X-API-Key

# === Environment ===
ENVIRONMENT=production
DEBUG=false

# === Deployment ===
REPLICAS=3
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# === Monitoring ===
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
